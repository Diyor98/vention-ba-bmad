# DeskHive — environment variables
# Copy this file to .env.local (gitignored) and fill in real values.

# PostgreSQL connection string.
# Recommended: free Neon project (https://neon.tech) for local development.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/deskhive

# Better Auth secret — 32-byte random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-32-byte-random-string

# Better Auth base URL (the app's public URL).
# Local dev: http://localhost:3000
# Staging (Railway): set in Railway env vars to the deployed URL.
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────
# Story 8-1 — Email service (Resend)
# ─────────────────────────────────────────────────────────────────────────

# Resend API key. Required at runtime when sending emails.
# Free-tier key from https://resend.com works for Phase 2.
RESEND_API_KEY=re_your_key_here

# Test-send recipient — read only by `pnpm send-test-email`.
# Set to your own inbox for Story 8-1 BA verification.
TEST_EMAIL_RECIPIENT=you@example.com

# Sender address. Default: 'onboarding@resend.dev' (Resend's sandbox
# sender — works out-of-the-box on the free tier with no DNS setup).
# Change to a verified-domain sender for production.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Per-template kill switch. Comma-separated template names that will
# return { status: 'disabled' } from sendEmail() without calling Resend.
# Use this to instantly silence a buggy template without a redeploy.
# Example: EMAIL_TEMPLATES_DISABLED=__test__,booking-confirmed-owner
EMAIL_TEMPLATES_DISABLED=

# Public HTTPS URL of the DeskHive logo PNG (committed at
# deskhive/public/email-assets/logo-deskhive.png). When set, transactional
# emails render the logo in the header. When unset (local-dev default),
# emails render only the "DeskHive" wordmark text — no <img> tag, no
# broken-image icon.
#
# For deploys: set to https://<your-deploy-url>/email-assets/logo-deskhive.png
EMAIL_LOGO_URL=

# Story 8-2: E2E test recording sink. When set to a writable file path,
# sendEmail appends one JSON line per call and SKIPS the actual Resend
# call. Used by Playwright tests to assert email-firing flows without
# depending on Resend's uptime. Production: LEAVE UNSET (no recording,
# Resend called normally). playwright.config.ts auto-sets this for E2E
# runs.
EMAIL_TEST_RECORD_FILE=
