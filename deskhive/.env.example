# DeskHive — environment variables
# Copy this file to .env.local (gitignored) and fill in real values.

# PostgreSQL connection string.
# Recommended: free Neon project (https://neon.tech) for local development.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/deskhive

# Better Auth secret — 32-byte random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-32-byte-random-string

# Better Auth base URL (the app's public URL).
# Local dev: http://localhost:3000
# Staging (Railway): set in Railway env vars to the deployed URL.
BETTER_AUTH_URL=http://localhost:3000
