# DeskHive — environment variables
# Copy this file to .env.local (gitignored) and fill in real values.

# PostgreSQL connection string.
# Recommended: free Neon project (https://neon.tech) for local development.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/deskhive

# Better Auth secret — 32-byte random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-32-byte-random-string

# Better Auth base URL (the app's public URL).
# Local dev: http://localhost:3000
# Staging (Railway): set in Railway env vars to the deployed URL.
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────
# Story 8-1 — Email service (Resend)
# ─────────────────────────────────────────────────────────────────────────

# Resend API key. Required at runtime when sending emails.
# Free-tier key from https://resend.com works for Phase 2.
RESEND_API_KEY=re_your_key_here

# Test-send recipient — read only by `pnpm send-test-email`.
# Set to your own inbox for Story 8-1 BA verification.
TEST_EMAIL_RECIPIENT=you@example.com

# Sender address — full From-header (display name + email). Resend
# requires the email portion to be from a verified domain; Story 8-1's
# sandbox sender 'onboarding@resend.dev' works out-of-the-box on the
# free tier. Default below is the Story 8-POLISH-1 (Decision §4) brand
# display-name pattern. Phase 3 will swap to a verified custom domain
# (e.g., 'DeskHive <notifications@deskhive.app>').
EMAIL_FROM_ADDRESS=DeskHive <onboarding@resend.dev>

# Per-template kill switch. Comma-separated template names that will
# return { status: 'disabled' } from sendEmail() without calling Resend.
# Use this to instantly silence a buggy template without a redeploy.
# Example: EMAIL_TEMPLATES_DISABLED=__test__,booking-confirmed-owner
EMAIL_TEMPLATES_DISABLED=

# Story 8-2: E2E test recording sink. When set to a writable file path,
# sendEmail appends one JSON line per call and SKIPS the actual Resend
# call. Used by Playwright tests to assert email-firing flows without
# depending on Resend's uptime. Production: LEAVE UNSET (no recording,
# Resend called normally). playwright.config.ts auto-sets this for E2E
# runs.
EMAIL_TEST_RECORD_FILE=

# ─────────────────────────────────────────────────────────────────────────
# Stories 9-1 / 9-2 — Payments (Stripe)
# ─────────────────────────────────────────────────────────────────────────
# Phase 2 PRD §3.3 locks DeskHive to Stripe test-mode for all of Phase 2.
# src/lib/stripe.ts validates these at module load and HARD-THROWS on
# misconfiguration — the dev server will refuse to start until both are
# set (the secret key in particular).

# Stripe secret key — server-side authentication. Get yours from the
# Stripe dashboard → Developers → API keys → "Secret key" (toggle to
# test mode first; the key prefix must be sk_test_*).
#
# src/lib/stripe.ts enforces:
#   - sk_test_*    → always allowed
#   - sk_live_*    → permitted ONLY when NODE_ENV=production
#   - anything else → throws at module load
STRIPE_SECRET_KEY=sk_test_51_your_key_here

# Stripe publishable key — client-side (browser) authentication. Reserved
# for Story 9-3, when the booking-with-payment UI initializes Stripe.js.
# Story 9-1 does NOT consume this; the entry is here so it's already
# in .env.local when 9-3 ships. Must start with pk_test_* outside
# production.
STRIPE_PUBLISHABLE_KEY=pk_test_51_your_key_here

# Stripe webhook signing secret — required by
# src/app/api/stripe/webhook/route.ts to verify payload authenticity.
# Get yours via:
#   - Local dev:  `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#                 (prints "Ready! Your webhook signing secret is whsec_*")
#   - Production: Stripe dashboard → Developers → Webhooks → endpoint
#                 signing secret
# Story 9-2 introduces this; Story 9-5 generalizes the webhook handler
# to consume more event types but the env var stays the same.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ─── DESIGN-INT-CHECKOUT-EMBED Phase 2 (read at build time) ───
# Client-side publishable key. Required by the new <BookingCheckoutEmbed>
# component (Stripe Embedded Checkout). Same publishable key as
# STRIPE_PUBLISHABLE_KEY above — but Next.js requires the NEXT_PUBLIC_*
# prefix to expose it to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51_your_key_here

# Feature flag for the embedded Checkout path. When 'true', the
# /spaces/[id] book button uses createBookingWithPaymentEmbeddedAction
# and mounts <BookingCheckoutEmbed> inline. When 'false' (or unset),
# the legacy hosted-Checkout redirect path runs (Story 9-3).
#
# Phase 2 default: 'false'. BA flips to 'true' for the post-CHECKPOINT
# walk; Phase 3 flips the default to 'true'; Phase 4 removes the flag.
NEXT_PUBLIC_CHECKOUT_EMBED_ENABLED=false
